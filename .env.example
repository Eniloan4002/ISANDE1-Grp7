# Local development only. Choose a password before starting Docker.
DB_PASSWORD=replace-with-a-local-password
DB_USER=ici_local
DB_URL=jdbc:postgresql://localhost:5432/ici_local

# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-generated-base64-key
JWT_TTL_MINUTES=15

# Enable only for first administrator provisioning; choose your own credentials.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
